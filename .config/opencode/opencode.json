{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "permission": {
    "websearch": "allow",
    "lsp": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTECT7_API_KEY": "${CONTECT7_API_KEY}"
      },
      "enabled": true
    }
  }

}
